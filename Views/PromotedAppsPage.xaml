<!--
  "Our other apps" in the family page standard (UI-3, PROMO-8). The named styles come from the
  host app's resources, merged from winui-app-kit's Xaml/Styles.xaml (v1.2.0 or later); the page
  carries no copy of them. README "Host requirements" lists every key it uses.
  Keep the ScrollViewer > StackPanel root and the AppList, TitleText and SubtitleText names: apps on
  older pins reach them from translation adapters until they delete those (PROMO-7).
-->
<Page
    x:Class="TechnicallyReal.Promo.PromotedAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock x:Name="TitleText" Text="Our other apps" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SubtitleText" Text="More apps from Dynamic Solutions (CA)." TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ItemsControl x:Name="AppList" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- The same gap as between the page's own cards (PageContentStyle). -->
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="40" Height="40" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Blurb}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{Binding ActionLabel}" Tag="{Binding Destination}"
                                        Click="OpenDestination_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
