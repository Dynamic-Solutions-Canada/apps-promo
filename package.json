  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check:catalog": "node --import tsx scripts/check-catalog.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run check:catalog && npm test",
    "catalog:refresh": "powershell -NoProfile -File scripts/refresh-catalog.ps1"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "tsx": "4.23.15"
  }
}
